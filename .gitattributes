# Built LevelDB packs are binary blobs; their JSON sources (packs/_source) stay text + diffable.
packs/** binary
packs/_source/** text=auto diff merge
assets/** filter=lfs diff=lfs merge=lfs -text
docs/art/journal-samples/*.png filter=lfs diff=lfs merge=lfs -text
docs/art/journal-samples/retired/*.webp filter=lfs diff=lfs merge=lfs -text
docs/art/journal-samples/encounters/**/*.png filter=lfs diff=lfs merge=lfs -text
