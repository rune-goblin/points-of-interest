# Built LevelDB packs are binary blobs; their JSON sources (packs/_source) stay text + diffable.
packs/** binary
packs/_source/** text=auto diff merge
assets/** filter=lfs diff=lfs merge=lfs -text
docs/art/journal-sources/**/*.png filter=lfs diff=lfs merge=lfs -text
docs/art/journal-sources/**/*.webp filter=lfs diff=lfs merge=lfs -text
